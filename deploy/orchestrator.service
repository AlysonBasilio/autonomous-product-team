[Unit]
Description=Autonomous Product Team orchestrator
Requires=docker.service
After=docker.service network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/orchestrator/repo/deploy
EnvironmentFile=/opt/orchestrator/repo/deploy/.env
ExecStart=/usr/bin/docker compose up -d --build
ExecStop=/usr/bin/docker compose down

[Install]
WantedBy=multi-user.target
